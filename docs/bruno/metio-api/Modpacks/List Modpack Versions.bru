meta {
  name: List Modpack Versions
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/modpacks/:id/versions
  auth: none
}

params:path {
  id: yourmodpack
}

docs {
  List the published versions of a pack, used by the version picker. Includes id, name, versionNumber, gameVersions, loaders and latest.
}
