meta {
  name: Report Backup
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/servers/:id/backups/report
  body: json
  auth: none
}

params:path {
  id: your-server-id
}

body:json {
  {
    "snapshotId": "abc123",
    "repositoryPrefix": "server-id",
    "durationSeconds": 42,
    "fileCount": 1234,
    "repositorySize": 567890,
    "minecraftVersion": "1.21.4",
    "status": "completed"
  }
}

docs {
  Called by the backup sidecar after a successful run to record a backup in the catalog.
}
