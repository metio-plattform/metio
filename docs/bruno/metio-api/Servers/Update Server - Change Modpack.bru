meta {
  name: Update Server - Change Modpack
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/api/servers/:id
  body: json
  auth: none
}

params:path {
  id: your-server-id
}

body:json {
  {
    "modpack": {
      "platform": "modrinth",
      "projectId": "anotherpack"
    }
  }
}

docs {
  Set or change the modpack. The pack is part of the VM user-data, so the server is recreated; world and player data on the persistent disk survive. See docs/MODPACKS.md.
}
