# Metio unified configuration (single source of truth)
# Copy to metio.env and fill in values for your environment

# GCP Configuration
GCP_PROJECT=TBD
GCP_REGION=TBD
GCP_ZONE=TBD
ENVIRONMENT=development

# Admin access
ADMIN_USERS=your-email@example.com
ALLOWED_USERS=your-email@example.com

# OAuth / Auth
GOOGLE_CLIENT_ID=TBD
GOOGLE_CLIENT_SECRET=TBD
SESSION_KEY=change-me
BASE_URL=http://localhost:3000

# Instance configuration (for devcontainer/machine access)
INSTANCE_NAME=TBD

# Database configuration
POSTGRES_MODE=cloudsql
# For byo mode (e.g., Neon, CockroachDB), set POSTGRES_CONNECTION_STRING_SECRET_ID
POSTGRES_CONNECTION_STRING_SECRET_ID=

# Backup configuration
BACKUP_DELETED_SERVER_RETENTION_DAYS=30
BACKUP_CLEANUP_SCHEDULE=0 * * * *

# OpenCode
OPENCODE_SERVER_PASSWORD=change-me

# Image registry configuration (optional - will be derived from git if not set)
# GITHUB_ORG=metio-plattform
# GITHUB_REPO=metio
# GCP_ARTIFACT_REGISTRY_PROJECT=minecraftbyl
# GCP_ARTIFACT_REGISTRY_LOCATION=europe-west3
# GCP_ARTIFACT_REGISTRY_REPO=metio
